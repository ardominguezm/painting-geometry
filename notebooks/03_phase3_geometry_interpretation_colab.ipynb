    "## 1. Recover the Phase-I and Phase-II outputs\n",
    "\n",
    "Upload the two ZIP files produced previously:\n",
    "\n",
    "- `painting_geometry_first_results.zip`\n",
    "- `painting_geometry_phase2_results.zip`\n",
    "\n",
    "Only the required CSV files are extracted. Curvature is **not** recomputed for the scale-ablation or artist-level analyses.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "521c588f",
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import files\n",
    "import io, zipfile, pandas as pd, numpy as np\n",
    "\n",
    "INPUT_DIR = Path(\"/content/phase3_inputs\")\n",
    "INPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "required_phase1 = {\"features_train_multiscale.csv\", \"features_test_multiscale.csv\"}\n",
    "optional_phase2 = {\"excluded_test_images.csv\"}\n",
    "\n",
    "def extract_needed_zip(blob: bytes, target: Path):\n",
    "    found = set()\n",
    "    with zipfile.ZipFile(io.BytesIO(blob)) as z:\n",
    "        for member in z.namelist():\n",
    "            base = Path(member).name\n",
    "            if base in required_phase1 | optional_phase2:\n",
    "                with z.open(member) as src, open(target / base, \"wb\") as dst:\n",
    "                    dst.write(src.read())\n",
    "                found.add(base)\n",
    "    return found\n",
    "\n",
    "if not all((INPUT_DIR / x).exists() for x in required_phase1):\n",
    "    print(\"Upload Phase-I and Phase-II ZIP files now.\")\n",
    "    uploaded = files.upload()\n",
    "    all_found = set()\n",
    "    for name, blob in uploaded.items():\n",
    "        if name.lower().endswith(\".zip\"):\n",
    "            all_found |= extract_needed_zip(blob, INPUT_DIR)\n",
    "        elif Path(name).name in required_phase1 | optional_phase2:\n",
    "            (INPUT_DIR / Path(name).name).write_bytes(blob)\n",
    "            all_found.add(Path(name).name)\n",
    "    print(\"Recovered:\", sorted(all_found))\n",
    "\n",
    "missing = [x for x in required_phase1 if not (INPUT_DIR / x).exists()]\n",
    "if missing:\n",
    "    raise FileNotFoundError(f\"Missing required Phase-I files: {missing}\")\n",
    "\n",
    "TRAIN_CSV = INPUT_DIR / \"features_train_multiscale.csv\"\n",
    "TEST_CSV = INPUT_DIR / \"features_test_multiscale.csv\"\n",
    "EXCLUDED_TEST = INPUT_DIR / \"excluded_test_images.csv\"\n",
    "if not EXCLUDED_TEST.exists():\n",
    "    print(\"WARNING: Phase-II excluded_test_images.csv not supplied; clean-corpus analyses will use the raw validation subset.\")\n",
    "\n",
    "train_df = pd.read_csv(TRAIN_CSV)\n",
    "test_df = pd.read_csv(TEST_CSV)\n",
    "print(\"Train:\", train_df.shape, \"Test:\", test_df.shape)\n",
    "print(\"Curvature columns:\", sum(c.startswith(\"curv__\") for c in train_df.columns))\n",
    "print(\"Orientation columns:\", sum(c.startswith(\"orient__\") for c in train_df.columns))\n"
   ]
  },

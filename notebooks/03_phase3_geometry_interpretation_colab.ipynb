    "\n",
    "print(\"Repository:\", REPO_DIR)\n",
    "print(\"Branch:\", BRANCH)\n",
    "print(\"Commit:\", subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip())\n"
   ]
  },

    "\n",
    "if RUN_RESOLUTION_ROBUSTNESS:\n",
    "    cmd = [\n",
    "        sys.executable, \"-u\", \"scripts/run_resolution_robustness.py\",\n",
    "        \"--root\", str(TRAIN_ROOT),\n",
    "        \"--output-dir\", str(PHASE3_RES),\n",
    "        \"--per-artist\", str(ROBUSTNESS_PER_ARTIST),\n",
    "        \"--seed\", \"42\",\n",
    "        \"--resolutions\", \"256\", \"512\", \"1024\",\n",
    "        \"--sigma-refs\", \"1\", \"2\", \"4\", \"8\",\n",
    "        \"--reference-long-side\", \"512\",\n",
    "    ]\n",
    "    subprocess.run(cmd, check=True)\n",
    "\n",
    "robustness = pd.read_csv(PHASE3_RES / \"resolution_robustness_summary.csv\")\n",
    "display(\n",
    "    robustness[\n",
    "        [\"feature\", \"n_complete\", \"icc3_1\", \"spearman_256_512\", \"spearman_512_1024\", \"spearman_256_1024\"]\n",
    "    ].sort_values(\"icc3_1\", ascending=False).head(25)\n",
    ")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7a881959",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Reviewer-facing stability summary.\n",
    "rho_cols = [\"spearman_256_512\", \"spearman_512_1024\", \"spearman_256_1024\"]\n",
    "robustness[\"min_pairwise_rho\"] = robustness[rho_cols].min(axis=1)\n",
    "\n",
    "stable = robustness[\n",
    "    (robustness[\"icc3_1\"] >= 0.75) &\n",
    "    (robustness[\"min_pairwise_rho\"] >= 0.80)\n",
    "].copy()\n",
    "\n",
    "print(f\"Stable descriptors (ICC>=0.75 and every rho>=0.80): {len(stable)} / {len(robustness)}\")\n",
    "display(stable[[\"feature\", \"icc3_1\", \"min_pairwise_rho\"]].head(30))\n",
    "\n",
    "plt.figure(figsize=(7, 5))\n",
    "plt.scatter(robustness[\"min_pairwise_rho\"], robustness[\"icc3_1\"], alpha=0.7)\n",
    "plt.axvline(0.80, linestyle=\"--\")\n",
    "plt.axhline(0.75, linestyle=\"--\")\n",
    "plt.xlabel(\"Minimum pairwise Spearman rho\")\n",
    "plt.ylabel(\"ICC(3,1)\")\n",
    "plt.title(\"Resolution stability of Phase-III geometry descriptors\")\n",
    "plt.tight_layout()\n",
    "fig_path = PHASE3_RES / \"Figure_resolution_stability.png\"\n",
    "plt.savefig(fig_path, dpi=220, bbox_inches=\"tight\")\n",
    "plt.show()\n"
   ]
  },
